
rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ==================================
    // HELPER FUNCTIONS
    // ==================================

    // Check whether user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Check whether user document exists
    function userExists() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    // Get current user's document
    function userData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    // Check whether current user is an ADMIN (R6-S2, R6-S6)
    function isAdmin() {
      return userExists()
        && userData().get('role', '') == 'ADMIN';
    }

    // Check whether current user is a CLUB (R6-S2)
    function isClub() {
      return userExists()
        && userData().get('role', '') == 'CLUB'
        && userData().get('clubId', '') != '';
    }

    // Check whether current user is a STUDENT (R6-S2)
    function isStudent() {
      return userExists()
        && userData().get('role', '') == 'STUDENT';
    }

    // Check whether current club owns the event
    function isClubOwner(clubId) {
      return isClub()
        && clubId != null
        && userData().get('clubId', '') == clubId;
    }

    // Check whether event is finalised
    function isFinalised(status) {
      return status == 'APPROVED'
        || status == 'REJECTED';
    }

    // Check required event fields
    function hasEventFields(data) {
      return data.keys().hasAll([
        'clubId',
        'status'
      ])
      && data.get('clubId', null) != null
      && data.get('status', null) != null;
    }

    // ==================================
    // 1. USERS (R6-S1, R6-S2, R6-S4, R6-S5)
    // ==================================

    match /users/{userId} {

      // Users can read their own document; Admins can read all users
      allow read: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());

      // Student registration (R6-S2 EX1: role forcibly STUDENT, client role param ignored)
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'STUDENT';

      // Admins can update user document (e.g. deactivate account, update end year)
      allow update: if isAdmin();

      // Deletion denied
      allow delete: if false;
    }

    // ==================================
    // 2. EVENTS
    // ==================================

    match /events/{eventId} {

      // Any signed-in user can read APPROVED events.
      // Clubs can also read their own events (DRAFT, PENDING, APPROVED, REJECTED).
      // Admins can read all events.
      allow read: if isSignedIn()
        && (
          isAdmin() ||
          (hasEventFields(resource.data) && (resource.data.status == 'APPROVED' || isClubOwner(resource.data.clubId)))
        );

      // Clubs can create their own events in DRAFT or PENDING status (R1-S1, R1-S2).
      allow create: if hasEventFields(request.resource.data)
        && isClubOwner(request.resource.data.clubId)
        && (request.resource.data.status == 'DRAFT' || request.resource.data.status == 'PENDING');

      // Clubs can update their own non-finalised events. Admins can update for approvals.
      allow update: if isAdmin() || (
        hasEventFields(resource.data)
        && hasEventFields(request.resource.data)
        && isClubOwner(resource.data.clubId)
        && resource.data.clubId == request.resource.data.clubId
        && !isFinalised(resource.data.status)
        && request.resource.data.status != 'APPROVED'
        && request.resource.data.status != 'REJECTED'
      );

      // Clubs can delete their own non-finalised events.
      allow delete: if isClubOwner(resource.data.clubId)
        && !isFinalised(resource.data.status);
    }

    // ==================================
    // 3. BOOKINGS (R2, R6-S5 EX2)
    // ==================================

    match /bookings/{bookingId} {

      allow read: if isSignedIn()
        && (resource.data.studentId == request.auth.uid || isAdmin());

      // Students can create bookings for themselves.
      allow create: if isStudent()
        && request.resource.data.keys().hasAll(['studentId'])
        && request.resource.data.studentId == request.auth.uid;

      // Admins can update bookings (e.g. cancellation on account deactivation R6-S5 EX2).
      allow update: if isAdmin();
    }

    // ==================================
    // 4. AUDIT LOGS (R6-S6)
    // ==================================

    match /audit_logs/{auditId} {

      // Only Admins can read audit logs (R6-S6 AC1)
      allow read: if isAdmin();

      // Writing audit logs requires 2FA verified flag, actorId, action, targetId and reason (R6-S6 AC1)
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['actorId', 'action', 'targetId', 'reason', 'verified2Fa', 'timestamp'])
        && request.resource.data.reason.size() > 0;

      // Immutable audit log requirement: update and delete strictly prohibited (R6-S6 AC1)
      allow update, delete: if false;
    }

  }
}
