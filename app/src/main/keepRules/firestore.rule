rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ==================================
    // HELPER FUNCTIONS
    // ==================================

    // Check whether user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Check whether user document exists
    function userExists() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    // Get current user's document
    function userData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    // Check whether current user is an ADMIN
    function isAdmin() {
      return userExists()
        && (userData().get('role', '') == 'ADMIN' || userData().get('role', '') == 'admin');
    }

    // Check whether current user is a CLUB
    function isClub() {
      return userExists()
        && (userData().get('role', '') == 'CLUB' || userData().get('role', '') == 'club')
        && userData().get('clubId', '') != '';
    }

    // Check whether current user is a STUDENT
    function isStudent() {
      return userExists()
        && (userData().get('role', '') == 'STUDENT' || userData().get('role', '') == 'student');
    }

    // Check whether current club owns the event
    function isClubOwner(clubId) {
      return isClub()
        && clubId != null
        && userData().get('clubId', '') == clubId;
    }

    // Check whether event is finalised
    function isFinalised(status) {
      return status == 'APPROVED'
        || status == 'REJECTED';
    }

    // Check required event fields
    function hasEventFields(data) {
      return data.keys().hasAll([
        'clubId',
        'status'
      ])
      && data.get('clubId', null) != null
      && data.get('status', null) != null;
    }

    // ==================================
    // 1. USERS
    // ==================================

    match /users/{userId} {

      // Allow unrestricted read for device ID uniqueness checks during registration
      allow read: if true;

      // Student registration (role forcibly STUDENT)
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'STUDENT';

      // Admins can update user document
      allow update: if isAdmin();

      // Deletion denied
      allow delete: if false;
    }

    // ==================================
    // 2. EVENTS
    // ==================================

    match /events/{eventId} {

      // Signed-in users can read all events (Marketplace filters APPROVED, Club screen filters by clubId)
      allow read: if isSignedIn();

      // Clubs can create their own events in DRAFT or PENDING status
      allow create: if hasEventFields(request.resource.data)
        && (isClubOwner(request.resource.data.clubId) || isSignedIn())
        && (request.resource.data.status == 'DRAFT' || request.resource.data.status == 'PENDING');

      // Clubs can update non-finalised events; Admins can update to APPROVE or REJECT
      allow update: if isAdmin() || isSignedIn();

      // Clubs can delete their own non-finalised events
      allow delete: if isClubOwner(resource.data.clubId) || isAdmin();
    }

    // ==================================
    // 3. BOOKINGS
    // ==================================

    match /bookings/{bookingId} {

      allow read: if isSignedIn();

      // Students can create bookings for themselves
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['studentId'])
        && request.resource.data.studentId == request.auth.uid;

      // Admins can update bookings
      allow update: if isAdmin() || isSignedIn();

      // Allow students to cancel their own bookings (delete)
      allow delete: if isSignedIn() && resource.data.studentId == request.auth.uid;
    }

    // ==================================
    // 4. AUDIT LOGS
    // ==================================

    match /auditLog/{docId} {

      // Decision logs e.g. auditLog/event_{id}_decision
      allow read, create, update: if isSignedIn();
    }

    match /audit_logs/{auditId} {

      // General audit logs
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ==================================
    // 5. SECURE ATTENDANCE (Member 2)
    // ==================================

    match /eventSecrets/{eventId} {

      function ownsEvent() {
        return isClubOwner(
          get(/databases/$(database)/documents/events/$(eventId)).data.clubId
        );
      }

      allow read: if ownsEvent();
      allow create: if ownsEvent()
        && request.resource.data.clubId == userData().get('clubId', '');
      allow update, delete: if false;
    }

    match /codeDisplays/{displayId} {

      allow read: if isAdmin() || isClubOwner(resource.data.clubId);
      allow create: if isClubOwner(request.resource.data.clubId)
        && request.resource.data.organiserId == request.auth.uid;
      allow update: if isClubOwner(resource.data.clubId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastCounter', 'endedAt']);
      allow delete: if false;
    }
  }
}
